{
  "realm": "tenantry",
  "adminPermissionsEnabled": true,
  "displayName": "Tenantry",
  "enabled": true,
  "sslRequired": "external",

  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,

  "smtpServer": {
    "host": "mailpit.keycloak.svc",
    "port": "1025",
    "from": "no-reply@${PORTAL_HOST}",
    "fromDisplayName": "Tenantry",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "revokeRefreshToken": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,

  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Tenantry Platform Admin: registers clusters, approves Organizations, grants capacity. Grants nothing in Kubernetes."
      }
    ]
  },

  "clients": [
    {
      "clientId": "portal",
      "name": "Tenantry portal",
      "description": "Platform API acting as a backend-for-frontend; the browser never holds a token.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PORTAL_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://${PORTAL_HOST}/auth/callback", "http://localhost:5173/auth/callback"],
      "webOrigins": ["https://${PORTAL_HOST}", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PORTAL_HOST}/"
      },
      "protocolMappers": [
        {
          "name": "audience portal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "headlamp-cluster-a",
      "name": "Headlamp console of cluster-a",
      "description": "Its ID token (aud headlamp-cluster-a) is what Headlamp sends to the cluster through Capsule Proxy.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${HEADLAMP_CLUSTER_A_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://${CONSOLE_HOST}/oidc-callback"],
      "webOrigins": ["https://${CONSOLE_HOST}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${CONSOLE_HOST}/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kubectl",
      "name": "kubectl (kubelogin)",
      "description": "Public client on the user's machine: PKCE, loopback redirect, no client secret, no password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:8000", "http://localhost:18000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience kubernetes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kubernetes",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cluster-verify",
      "name": "make cluster-verify",
      "description": "Lets cluster-verify get a token without a browser (client credentials). Its secret lives only in the cluster; the token names a service account that Kubernetes grants nothing.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CLUSTER_VERIFY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience kubernetes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kubernetes",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenantry-sync",
      "name": "Tenantry group sync",
      "description": "Service account of the group sync worker: mirrors organization groups and memberships and turns accounts on and off. realm-management query-users and query-groups only; the rest through fine-grained admin permissions (deploy/cluster/keycloak-fgap.py): no password reset, no role mapping, no impersonation, nothing on Platform Admins. Only the tenantry-worker-groupsync Deployment holds its secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${TENANTRY_SYNC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "roles", "service_account", "kc-admin-api"],
      "optionalClientScopes": []
    }
  ],

  "clientScopeMappings": {
    "realm-management": [{"client": "tenantry-sync", "roles": ["query-users", "query-groups"]}]
  },

  "users": [
    {
      "username": "admin",
      "email": "admin@tenantry.site",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "realmRoles": ["default-roles-tenantry", "platform-admin"],
      "credentials": [{"type": "password", "value": "${PLATFORM_ADMIN_PASSWORD}", "temporary": false}]
    },
    {
      "username": "alice",
      "email": "alice@tenantry.site",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "enabled": true,
      "realmRoles": ["default-roles-tenantry"],
      "credentials": [{"type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "joe",
      "email": "joe@tenantry.site",
      "emailVerified": true,
      "firstName": "Joe",
      "lastName": "Demo",
      "enabled": true,
      "realmRoles": ["default-roles-tenantry"],
      "credentials": [{"type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "bob",
      "email": "bob@tenantry.site",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "enabled": true,
      "realmRoles": ["default-roles-tenantry"],
      "credentials": [{"type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "mallory",
      "email": "mallory@tenantry.site",
      "emailVerified": true,
      "firstName": "Mallory",
      "lastName": "Demo",
      "enabled": true,
      "realmRoles": ["default-roles-tenantry"],
      "credentials": [{"type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "service-account-cluster-verify",
      "enabled": true,
      "realmRoles": ["default-roles-tenantry"],
      "serviceAccountClientId": "cluster-verify"
    },
    {
      "username": "service-account-tenantry-sync",
      "enabled": true,
      "serviceAccountClientId": "tenantry-sync",
      "clientRoles": {"realm-management": ["query-users", "query-groups"]}
    }
  ]
}
