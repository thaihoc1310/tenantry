    {
      "id": 15,
      "type": "timeseries",
      "title": "workspace.create duration p50 / p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tenantry_operation_duration_seconds_bucket{type=\"workspace.create\"}[1h])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tenantry_operation_duration_seconds_bucket{type=\"workspace.create\"}[1h])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Outbox: pending events and age of the oldest",
      "description": "Events the provisioning worker has not delivered to a cluster yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (cluster) (tenantry_outbox_pending_events)",
          "legendFormat": "pending {{cluster}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (cluster) (tenantry_outbox_oldest_pending_seconds)",
          "legendFormat": "oldest {{cluster}} (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Free address blocks per network pool and prefix length",
      "description": "How many default-size CIDRs each network pool can still give out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "tenantry_network_pool_free_blocks",
          "legendFormat": "{{pool}} /{{prefix_length}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Group sync: pending, oldest, failures",
      "description": "Group and membership changes waiting for Keycloak.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (kind) (tenantry_groupsync_pending)",
          "legendFormat": "pending {{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (kind) (tenantry_groupsync_oldest_pending_seconds)",
          "legendFormat": "oldest {{kind}} (s)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (kind) (rate(tenantry_groupsync_failures_total[5m]))",
          "legendFormat": "failures/s {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "DB pool: connections in use against the maximum",
      "description": "Per process. A pool held at its maximum makes every request wait for a connection, as the portal did when a session refresh held one while Keycloak answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(tenantry_db_pool_acquired_connections, \"process\", \"$1\", \"instance\", \"tenantry-(.*)-metrics\\\\..*\")",
          "legendFormat": "in use {{process}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(tenantry_db_pool_max_connections, \"process\", \"$1\", \"instance\", \"tenantry-(.*)-metrics\\\\..*\")",
          "legendFormat": "max {{process}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "DB pool: waits for a connection",
      "description": "Per process: acquires per second that found no free connection, and the mean wait of those.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 73,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(rate(tenantry_db_pool_waits_total[5m]), \"process\", \"$1\", \"instance\", \"tenantry-(.*)-metrics\\\\..*\")",
          "legendFormat": "waits/s {{process}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(rate(tenantry_db_pool_wait_seconds_total[5m]) / rate(tenantry_db_pool_waits_total[5m]), \"process\", \"$1\", \"instance\", \"tenantry-(.*)-metrics\\\\..*\")",
          "legendFormat": "mean wait (s) {{process}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Shared pools: CPU requested by running Pods against allocatable",
      "description": "From kube-state-metrics: the CPU requests of the Pods running on each shared pool's nodes, next to what the nodes can hold. Past allocatable nothing more schedules there, whatever the platform's allocation ceiling allows (ADR-0017).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 81,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(sum by (label_tenantry_io_compute_pool) (sum by (namespace, pod, node) (kube_pod_container_resource_requests{resource=\"cpu\"}) * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=\"Running\"}) == 1) * on (node) group_left (label_tenantry_io_compute_pool) kube_node_labels{label_tenantry_io_compute_pool!=\"\", label_tenantry_io_compute_pool!=\"system\"}), \"pool\", \"$1\", \"label_tenantry_io_compute_pool\", \"(.*)\")",
          "legendFormat": "{{pool}} requested by running Pods"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "tenantry_shared_pool_allocatable{resource=\"cpu\"}",
          "legendFormat": "{{pool}} allocatable"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Pods the scheduler cannot place, by Workspace",
      "description": "From kube-state-metrics: Pods Pending as Unschedulable in each Workspace's Namespaces. On a Shared Workspace it usually means its pool is full, not that its quota is.",
      "datasource": {
        "type": "prometheus",
