      "id": 13,
      "type": "timeseries",
      "title": "API requests per second, by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
